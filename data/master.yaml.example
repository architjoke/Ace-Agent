# Copy to data/master.yaml and fill with YOUR facts only.
# Never invent employers, metrics, or skills. This is the RenderCV fact bank
# the agent trims per job description.
#
# application_answers: browser/ATS form fill (ignored by RenderCV resume render).

application_answers:
  # Narrative prefs (never typed into digit-only boxes):
  notice_period: "7 to 14 days"
  earliest_join_date: "Within 7–14 days of offer acceptance"
  # Form-safe integers / digits (FormFillEngine reads these):
  notice_period_days: "7"
  current_ctc_inr: "0"
  expected_ctc_inr: "650000"
  years_of_experience: "0"
  additional_months_of_experience: "6"
  phone_e164: "+91XXXXXXXXXX"
  phone_display: "+91 XXXXXXXXXX"
  phone_national: "XXXXXXXXXX"
  phone_country_code: "+91"
  city: "Your City"
  state: "Your State"
  country: "India"
  pincode: "000000"
  address_line: "City, State PIN, India"
  work_authorization: "Authorized to work in India"
  require_visa_sponsorship_india: "No"
  willing_to_relocate_india: "Yes"
  preferred_work_mode: "Remote, hybrid, or on-site"
  # Eligibility prefs for yes/no screening (not employer Q→A):
  open_to_internship_months: "6"
  can_commit_hours_per_day: "8"
  has_ai_llm_projects: "Yes"
  portfolio_url: ""
  university_start_month: "August"
  university_start_year: "2024"
  university_end_month: "May"
  university_end_year: "2027"
  university_currently_attending: "Yes"
  graduation_year: "2027"
  expected_ctc: "₹6,00,000 – ₹7,00,000 per annum"
  salary_expectation: "₹6,00,000 – ₹7,00,000 per annum"
  how_did_you_hear: "LinkedIn"

cv:
  name: Your Full Name
  location: City, Region, Country
  email: you@example.com
  phone: "+91 XXXXXXXXXX"
  social_networks:
    - network: LinkedIn
      username: your-linkedin-slug
    - network: GitHub
      username: your-github

  sections:
    summary:
      - "One dense paragraph: degree + stack + internship/project focus. Truthful only."

    education:
      - institution: Your University
        area: Computer Science
        degree: B.Tech / B.S.
        start_date: "2023-08"
        end_date: "2027-05"
        location: City
        highlights:
          - "CGPA: X.X/10"
          - "Coursework: DSA, OOP, OS, DBMS, Networks, ML."

    experience:
      - company: Example Intern Co
        position: Software Engineering Intern
        start_date: "2025-05"
        end_date: "2025-08"
        location: City / Remote
        highlights:
          - "Built X using Y; improved Z by measurable metric from fact bank only."
          - "Second XYZ bullet with real stack (Python, React, SQL, …)."
          - "Third XYZ bullet."

    projects:
      - name: Project One
        date: "2025"
        highlights:
          - "What you built + tools (truthful)."
          - "Second bullet."
          - "Third bullet."
      - name: Project Two
        date: "2024"
        highlights:
          - "What you built + tools."
          - "Second bullet."
          - "Third bullet."

    skills:
      - label: Languages
        details: Python, TypeScript, SQL
      - label: Frameworks
        details: React, Node.js, FastAPI
      - label: ML / Data
        details: Scikit-learn, PyTorch, Pandas
      - label: Tools
        details: Git, Docker, Linux
