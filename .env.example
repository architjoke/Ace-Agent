# Copy to .env and fill locally. Never commit .env.
#
# Multi-model routing (matches config.yaml llm: block unless ACE_*_PROVIDER pins override):
#   browser-use / CDP  → Gemini vision ONLY
#   draft / fallback   → OpenAI → NVIDIA → Ollama
#   triage (fit)       → Cohere → NVIDIA → Ollama
#   semantic DOM       → Groq → NVIDIA
#   reflect / inbox    → Ollama → NVIDIA → Cohere

# --- Browser (Gemini EXCLUSIVE — DOM/vision only) ---
# Either GOOGLE_API_KEY or GEMINI_API_KEY is accepted.
GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=
GEMINI_BROWSER_MODEL=gemini-3.5-flash-lite
ACE_ALLOW_GEMINI_TEXT=0

# --- draft / fallback ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- triage (fit) — Cohere trial ~1k calls/month ---
COHERE_API_KEY=your_cohere_trial_key
COHERE_MODEL=command-r-08-2024

# --- semantic DOM (keep Groq RPM for playbooks) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
GROQ_REASONING_EFFORT=low

# --- shared cloud failover ---
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_MODEL=mistralai/mistral-small-3.1-24b-instruct-2503

# --- night-shift local: reflect / inbox ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Role pins (optional — omit to use config.yaml llm: defaults)
# ACE_DRAFT_PROVIDER=openai
# ACE_TRIAGE_PROVIDER=cohere
# ACE_FALLBACK_PROVIDER=openai
# ACE_SEMANTIC_PROVIDER=groq
ACE_REFLECT_PROVIDER=ollama
ACE_INBOX_PROVIDER=ollama

# Auto-submit: 1 = click final Submit | 0 = stop at READY_FOR_REVIEW
ACE_AUTO_SUBMIT=1

# Filename uploaded to LinkedIn/ATS (fresh Upload every apply)
ACE_APPLY_RESUME_FILENAME=Your_Name_Resume.pdf

# Permanent LinkedIn library resumes to NEVER delete (pipe-separated substrings)
# ACE_LINKEDIN_KEEP_RESUMES=My_SDE_Resume|My_ML_Resume

# Email (IMAP inbox outcomes + optional SMTP brief)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Parallel apply
# ACE_BROWSER_WORKERS=3
# ACE_TAILOR_WORKERS=4
# ACE_GROQ_CONCURRENCY=2
# ACE_LINKEDIN_MAX_PER_HOUR=10
# Fast-fail circuit breaker (Easy Apply defaults). Heavy ATS uses ACE_WORKDAY_* caps.
# ACE_BROWSER_USE_TIMEOUT_SECONDS=180
# ACE_BROWSER_USE_MAX_STEPS=10
# ACE_WORKDAY_TIMEOUT_SECONDS=300
# ACE_WORKDAY_MAX_STEPS=20
# Warm Chromium between applies (pool workers setdefault to 1).
# Set 0 only to force anti-zombie teardown after every job.
ACE_BROWSER_KEEP_ALIVE=1
# Warm Chromium slot max age before relaunch (hours); default 6
ACE_BROWSER_SLOT_TTL_HOURS=6
# Orphan CLAIMED reclaim on ace start / worker boot (no SQLite schema change).
# Under max → READY retry; at/over max → DONE + applications FAILED_INTERRUPTED.
ACE_CLAIM_RECLAIM_MAX=2
# Mid-run stale CLAIMED → READY when worker is still alive (seconds).
ACE_CLAIM_STALE_SEC=3600
# Host-aware claim scan window (READY rows considered for eligibility).
ACE_CLAIM_SCAN_LIMIT=500
# Bound long-running daemon disk use (bytes). Worker log: output/ace_worker.log
ACE_TELEMETRY_MAX_BYTES=20000000
ACE_LOG_MAX_BYTES=20000000
# Cold-path: producer fan-in + delay Playwright until READY≥N (anti-starvation).
ACE_PRODUCER_CONCURRENCY=15
ACE_QUEUE_WARM_THRESHOLD=5
# Discovery process deadlines (kill hung scrapers; merge partial results).
ACE_DISCOVERY_TRACK_TIMEOUT_S=120
ACE_DISCOVERY_OVERALL_TIMEOUT_S=300
ACE_EXTRA_DISCOVERY_TIMEOUT_S=90
ACE_JOBDROP_SITE_TIMEOUT_S=35
# Reuse tailored PDFs for exact JD fingerprint hits (hours); skips LLM+RenderCV.
# Title alone never bypasses keyword fit — fingerprint includes JD keywords + master hash.
ACE_ARCHETYPE_CACHE_HOURS=48
# ACE_HOST_LIMITS=linkedin.com=120:20,naukri.com=60:15
ACE_APPLY_HOURS=8-22
ACE_LINKEDIN_MAX_PER_DAY=40
ACE_CF_TRIP_THRESHOLD=3
ACE_CF_TRIP_WINDOW_SEC=1800
ACE_CF_COOLDOWN_SEC=3600
ACE_BROWSER_LOCALE=en-IN
ACE_BROWSER_TIMEZONE=Asia/Kolkata

ACE_SEMANTIC_DOM=1
ACE_CAPTCHA_HUMAN=1
ACE_CAPTCHA_WAIT_S=300
# Disk scratch GC: archive PDF → Submitted/, drop output/<Company>/ after SUCCESS or Manual_Action cleanup. Never GC while Manual_Action/<Company>/ exists.
ACE_OUTPUT_GC_ON_SUCCESS=1
ACE_OUTPUT_PRUNE_STALE=1
ACE_OUTPUT_BUILD_TTL_DAYS=14
ACE_OUTPUT_PRUNE_INTERVAL_HOURS=12

# Empty = direct IP. Sticky residential only when you have one; then ace login --verify
PROXY_URL=
# PROXY_URLS=

# ACE_GROQ_TIMEOUT=120
# ACE_NVIDIA_TIMEOUT=120
# ACE_OPENAI_TIMEOUT=120
# ACE_MAX_DRAFT_REVISIONS=2
# ACE_BROWSER_USER_AGENT=Mozilla/5.0 ...
# ACE_BROWSER_VIEWPORT=1920x1080
# ACE_BROWSER_DEVICE_SCALE=1
# ACE_BROWSER_HEADLESS=1

# python -m playwright install chromium
