# Copy to .env and fill locally. Never commit .env.
#
# Multi-model routing (matches config.yaml llm: block unless ACE_*_PROVIDER pins override):
#   browser-use / CDP  → Gemini vision ONLY
#   draft / fallback   → OpenAI → NVIDIA → Ollama
#   triage (fit)       → Cohere → NVIDIA → Ollama
#   semantic DOM       → Groq → NVIDIA
#   reflect / inbox    → Ollama → NVIDIA → Cohere

# --- Browser (Gemini EXCLUSIVE — DOM/vision only) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_BROWSER_MODEL=gemini-3.5-flash-lite
ACE_ALLOW_GEMINI_TEXT=0

# --- draft / fallback ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- triage (fit) — Cohere trial ~1k calls/month ---
COHERE_API_KEY=your_cohere_trial_key
COHERE_MODEL=command-r-08-2024

# --- semantic DOM (keep Groq RPM for playbooks) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
GROQ_REASONING_EFFORT=low

# --- shared cloud failover ---
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_MODEL=mistralai/mistral-small-3.1-24b-instruct-2503

# --- night-shift local: reflect / inbox ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Role pins (optional — omit to use config.yaml llm: defaults)
# ACE_DRAFT_PROVIDER=openai
# ACE_TRIAGE_PROVIDER=cohere
# ACE_FALLBACK_PROVIDER=openai
# ACE_SEMANTIC_PROVIDER=groq
ACE_REFLECT_PROVIDER=ollama
ACE_INBOX_PROVIDER=ollama

# Auto-submit: 1 = click final Submit | 0 = stop at READY_FOR_REVIEW
ACE_AUTO_SUBMIT=1

# Filename uploaded to LinkedIn/ATS (fresh Upload every apply)
ACE_APPLY_RESUME_FILENAME=Your_Name_Resume.pdf

# Permanent LinkedIn library resumes to NEVER delete (pipe-separated substrings)
# ACE_LINKEDIN_KEEP_RESUMES=My_SDE_Resume|My_ML_Resume

# Email (IMAP inbox outcomes + optional SMTP brief)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Parallel apply
# ACE_BROWSER_WORKERS=3
# ACE_TAILOR_WORKERS=4
# ACE_GROQ_CONCURRENCY=2
# ACE_LINKEDIN_MAX_PER_HOUR=10
# Fast-fail circuit breaker (Easy Apply defaults). Heavy ATS uses ACE_WORKDAY_* caps.
# ACE_BROWSER_USE_TIMEOUT_SECONDS=180
# ACE_BROWSER_USE_MAX_STEPS=10
# ACE_WORKDAY_TIMEOUT_SECONDS=300
# ACE_WORKDAY_MAX_STEPS=20
# Tear down Chromium after each apply (set 1 only if you accept zombie risk).
ACE_BROWSER_KEEP_ALIVE=0

# Groq-first semantic DOM apply before Gemini vision (1=on, 0=off)
ACE_SEMANTIC_DOM=1

# Sticky proxy for Chromium / browser-use (LinkedIn session stays on one egress IP).
# JobSpy also uses PROXY_URL plus config.yaml network.proxies for discovery rotation.
# Leave empty for direct egress. Re-run: ace login --verify  after changing PROXY_URL.
PROXY_URL=
# Extra proxy pool for burn/rotate (comma or newline separated).
# PROXY_URLS=http://user:pass@proxy2:8080,http://user:pass@proxy3:8080

# Optional timeouts (seconds)
# ACE_GROQ_TIMEOUT=120
# ACE_NVIDIA_TIMEOUT=120
# ACE_OPENAI_TIMEOUT=120
# ACE_MAX_DRAFT_REVISIONS=2

# Pin fingerprint (do not randomize). Optional overrides:
# ACE_BROWSER_USER_AGENT=Mozilla/5.0 ...
# ACE_BROWSER_VIEWPORT=1920x1080
# ACE_BROWSER_DEVICE_SCALE=1
# Overnight headless: ACE_BROWSER_HEADLESS=1  (or config.yaml browser.headless: true)

# After installing rebrowser-playwright:
#   python -m playwright install chromium
